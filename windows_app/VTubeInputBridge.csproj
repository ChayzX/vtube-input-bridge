<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds VTubeInputBridge.exe for the .NET Framework 4.8 built into Windows, from Linux or Windows, so the
       unified app can ship the tracking helper. scripts/build-windows.ps1 still compiles the same files with csc. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VTubeInputBridge</AssemblyName>
    <ApplicationIcon>bridge.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BridgeCore.cs;SenderRuntime.cs;MouseMotion.cs;SenderSettings.cs;RawMouseInput.cs;WindowsInputCapture.cs;HeadlessSender.cs;BridgeApp.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
